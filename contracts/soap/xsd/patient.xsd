<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://vida-integrada.example.com/contracts/patient/v1" xmlns:pt="http://vida-integrada.example.com/contracts/patient/v1" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:simpleType name="UuidType"><xs:restriction base="xs:string"><xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="PatientIdType"><xs:restriction base="pt:UuidType"/></xs:simpleType>
  <xs:simpleType name="PatientNameType"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="200"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="CpfType"><xs:restriction base="xs:string"><xs:pattern value="[0-9]{11}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="EmailType"><xs:restriction base="xs:string"><xs:maxLength value="254"/><xs:pattern value="[^@ ]+@[^@ ]+\.[^@ ]+"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="PhoneType"><xs:restriction base="xs:string"><xs:pattern value="\+[1-9][0-9]{7,14}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ErrorCodeType"><xs:restriction base="xs:string"><xs:enumeration value="PATIENT_NOT_FOUND"/><xs:enumeration value="APPOINTMENT_NOT_FOUND"/><xs:enumeration value="INVALID_PATIENT"/><xs:enumeration value="DUPLICATE_PATIENT"/><xs:enumeration value="INVALID_APPOINTMENT"/><xs:enumeration value="INTERNAL_ERROR"/></xs:restriction></xs:simpleType>
  <xs:complexType name="PatientType"><xs:sequence><xs:element name="id" type="pt:PatientIdType" minOccurs="1" maxOccurs="1"/><xs:element name="name" type="pt:PatientNameType" minOccurs="1" maxOccurs="1"/><xs:element name="cpf" type="pt:CpfType" minOccurs="1" maxOccurs="1"/><xs:element name="birthDate" type="xs:date" minOccurs="1" maxOccurs="1"/><xs:element name="email" type="pt:EmailType" minOccurs="0" maxOccurs="1"/><xs:element name="phone" type="pt:PhoneType" minOccurs="0" maxOccurs="1"/><xs:element name="createdAt" type="xs:dateTime" minOccurs="1" maxOccurs="1"/><xs:element name="updatedAt" type="xs:dateTime" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType>
  <xs:complexType name="CreatePatientInputType"><xs:sequence><xs:element name="name" type="pt:PatientNameType" minOccurs="1" maxOccurs="1"/><xs:element name="cpf" type="pt:CpfType" minOccurs="1" maxOccurs="1"/><xs:element name="birthDate" type="xs:date" minOccurs="1" maxOccurs="1"/><xs:element name="email" type="pt:EmailType" minOccurs="0" maxOccurs="1"/><xs:element name="phone" type="pt:PhoneType" minOccurs="0" maxOccurs="1"/></xs:sequence></xs:complexType>
  <xs:complexType name="UpdatePatientInputType"><xs:choice minOccurs="1" maxOccurs="1"><xs:sequence><xs:element name="name" type="pt:PatientNameType" minOccurs="1" maxOccurs="1"/><xs:element name="email" type="pt:EmailType" minOccurs="0" maxOccurs="1"/><xs:element name="phone" type="pt:PhoneType" minOccurs="0" maxOccurs="1"/></xs:sequence><xs:sequence><xs:element name="email" type="pt:EmailType" minOccurs="1" maxOccurs="1"/><xs:element name="phone" type="pt:PhoneType" minOccurs="0" maxOccurs="1"/></xs:sequence><xs:sequence><xs:element name="phone" type="pt:PhoneType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:choice></xs:complexType>
  <xs:complexType name="ServiceFaultDetailType"><xs:sequence><xs:element name="code" type="pt:ErrorCodeType" minOccurs="1" maxOccurs="1"/><xs:element name="message" type="xs:string" minOccurs="1" maxOccurs="1"/><xs:element name="correlationId" type="pt:UuidType" minOccurs="0" maxOccurs="1"/></xs:sequence></xs:complexType>
  <xs:element name="CreatePatientRequest"><xs:complexType><xs:sequence><xs:element name="patient" type="pt:CreatePatientInputType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="CreatePatientResponse"><xs:complexType><xs:sequence><xs:element name="patient" type="pt:PatientType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="GetPatientRequest"><xs:complexType><xs:sequence><xs:element name="patientId" type="pt:PatientIdType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="GetPatientResponse"><xs:complexType><xs:sequence><xs:element name="patient" type="pt:PatientType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="UpdatePatientRequest"><xs:complexType><xs:sequence><xs:element name="patientId" type="pt:PatientIdType" minOccurs="1" maxOccurs="1"/><xs:element name="patient" type="pt:UpdatePatientInputType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="UpdatePatientResponse"><xs:complexType><xs:sequence><xs:element name="patient" type="pt:PatientType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="ServiceFault" type="pt:ServiceFaultDetailType"/>
</xs:schema>
