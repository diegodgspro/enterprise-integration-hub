<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://vida-integrada.example.com/contracts/appointment/v1" xmlns:ap="http://vida-integrada.example.com/contracts/appointment/v1" xmlns:pt="http://vida-integrada.example.com/contracts/patient/v1" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:import namespace="http://vida-integrada.example.com/contracts/patient/v1" schemaLocation="patient.xsd"/>
  <xs:simpleType name="AppointmentIdType"><xs:restriction base="pt:UuidType"/></xs:simpleType>
  <xs:simpleType name="SpecialtyType"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="AppointmentStatusType"><xs:restriction base="xs:string"><xs:enumeration value="SCHEDULED"/><xs:enumeration value="CONFIRMED"/><xs:enumeration value="CANCELLED"/><xs:enumeration value="COMPLETED"/></xs:restriction></xs:simpleType>
  <xs:complexType name="AppointmentType"><xs:sequence><xs:element name="id" type="ap:AppointmentIdType" minOccurs="1" maxOccurs="1"/><xs:element name="patientId" type="pt:PatientIdType" minOccurs="1" maxOccurs="1"/><xs:element name="appointmentDate" type="xs:dateTime" minOccurs="1" maxOccurs="1"/><xs:element name="specialty" type="ap:SpecialtyType" minOccurs="1" maxOccurs="1"/><xs:element name="status" type="ap:AppointmentStatusType" minOccurs="1" maxOccurs="1"/><xs:element name="createdAt" type="xs:dateTime" minOccurs="1" maxOccurs="1"/><xs:element name="updatedAt" type="xs:dateTime" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType>
  <xs:complexType name="CreateAppointmentInputType"><xs:sequence><xs:element name="patientId" type="pt:PatientIdType" minOccurs="1" maxOccurs="1"/><xs:element name="appointmentDate" type="xs:dateTime" minOccurs="1" maxOccurs="1"/><xs:element name="specialty" type="ap:SpecialtyType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType>
  <xs:element name="CreateAppointmentRequest"><xs:complexType><xs:sequence><xs:element name="appointment" type="ap:CreateAppointmentInputType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="CreateAppointmentResponse"><xs:complexType><xs:sequence><xs:element name="appointment" type="ap:AppointmentType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="GetAppointmentRequest"><xs:complexType><xs:sequence><xs:element name="appointmentId" type="ap:AppointmentIdType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="GetAppointmentResponse"><xs:complexType><xs:sequence><xs:element name="appointment" type="ap:AppointmentType" minOccurs="1" maxOccurs="1"/></xs:sequence></xs:complexType></xs:element>
</xs:schema>
