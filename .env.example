# Ambiente de execução (valores de exemplo; não armazene segredos neste arquivo)
APP_ENV=development
LOG_LEVEL=INFO

# Banco de dados — reservado para a fase de persistência
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=integration_hub
POSTGRES_USER=integration_hub
POSTGRES_PASSWORD=change_me

# Segurança — reservado para a fase de autenticação JWT
JWT_SECRET_KEY=replace_with_a_secure_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

